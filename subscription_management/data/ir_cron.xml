<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_brightloop_subscription_billing" model="ir.cron">
        <field name="name">Brightloop: generate due subscription invoices</field>
        <field name="model_id" ref="model_brightloop_subscription"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_due_invoices()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_brightloop_subscription_expiry" model="ir.cron">
        <field name="name">Brightloop: close expired subscriptions</field>
        <field name="model_id" ref="model_brightloop_subscription"/>
        <field name="state">code</field>
        <field name="code">model._cron_close_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>

