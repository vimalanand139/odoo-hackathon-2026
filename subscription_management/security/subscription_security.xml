<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_brightloop_staff" model="res.groups">
        <field name="name">Subscription Staff</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_brightloop_manager" model="res.groups">
        <field name="name">Subscription Administrator</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('subscription_management.group_brightloop_staff'))]"/>
    </record>

    <record id="rule_brightloop_portal_subscription" model="ir.rule">
        <field name="name">Customers: own subscriptions only</field>
        <field name="model_id" ref="model_brightloop_subscription"/>
        <field name="domain_force">[('partner_id', 'child_of', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_brightloop_portal_line" model="ir.rule">
        <field name="name">Customers: lines on own subscriptions only</field>
        <field name="model_id" ref="model_brightloop_subscription_line"/>
        <field name="domain_force">[('subscription_id.partner_id', 'child_of', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_brightloop_staff_company" model="ir.rule">
        <field name="name">Staff: subscriptions in allowed companies</field>
        <field name="model_id" ref="model_brightloop_subscription"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('subscription_management.group_brightloop_staff'))]"/>
    </record>
    <record id="rule_brightloop_plan_company" model="ir.rule">
        <field name="name">Staff: plans in allowed companies</field>
        <field name="model_id" ref="model_brightloop_subscription_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('subscription_management.group_brightloop_staff'))]"/>
    </record>
</odoo>

