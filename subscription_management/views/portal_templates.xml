<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_subscriptions" name="My Subscriptions" inherit_id="portal.portal_my_home" priority="35">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Subscriptions</t>
                <t t-set="url" t-value="'/my/subscriptions'"/>
                <t t-set="count" t-value="request.env['brightloop.subscription'].with_user(request.env.user).search_count([('partner_id', 'child_of', request.env.user.partner_id.commercial_partner_id.id)])"/>
                <t t-set="placeholder_count" t-value="'subscription_count'"/>
            </t>
        </xpath>
    </template>
    <template id="portal_subscription_list" name="Portal Subscriptions">
        <t t-call="portal.portal_layout">
            <t t-set="title">My Subscriptions</t>
            <div class="container mt-3">
                <h2>My Subscriptions</h2>
                <t t-if="subscriptions">
                    <table class="table table-hover">
                        <thead><tr><th>Reference</th><th>Plan</th><th>Start</th><th>Next invoice</th><th>Status</th><th/></tr></thead>
                        <tbody><tr t-foreach="subscriptions" t-as="subscription">
                            <td><a t-att-href="subscription.get_portal_url()"><t t-out="subscription.name"/></a></td>
                            <td><t t-out="subscription.plan_id.name"/></td><td><t t-out="subscription.start_date"/></td>
                            <td><t t-out="subscription.next_invoice_date or '-'"/></td><td><span t-out="subscription.state" class="badge text-bg-info"/></td>
                            <td><a t-att-href="subscription.get_portal_url()" class="btn btn-sm btn-outline-primary">View</a></td>
                        </tr></tbody>
                    </table>
                    <t t-call="portal.pager"/>
                </t>
                <p t-else="">No subscriptions are linked to your account yet.</p>
            </div>
        </t>
    </template>
    <template id="portal_subscription" name="Portal Subscription Detail">
        <t t-call="portal.portal_layout">
            <t t-set="title">Subscription</t>
            <div class="container mt-3">
                <a href="/my/subscriptions">← My Subscriptions</a>
                <h2 class="mt-3"><t t-out="subscription.name"/></h2>
                <div class="row g-3">
                    <div class="col-md-6"><div class="card card-body"><h5>Subscription</h5><p><strong>Plan:</strong> <t t-out="subscription.plan_id.name"/></p><p><strong>Status:</strong> <t t-out="subscription.state"/></p><p><strong>Start:</strong> <t t-out="subscription.start_date"/></p><p><strong>Expires:</strong> <t t-out="subscription.end_date or '-'"/></p><p><strong>Next billing:</strong> <t t-out="subscription.next_invoice_date or '-'"/></p></div></div>
                    <div class="col-md-6"><div class="card card-body"><h5>Recurring total</h5><h3 t-out="subscription.amount_total" t-options="{'widget': 'monetary', 'display_currency': subscription.currency_id}"/></div></div>
                </div>
                <h4 class="mt-4">Products</h4>
                <table class="table"><thead><tr><th>Product</th><th>Qty</th><th>Unit price</th><th>Total</th></tr></thead><tbody>
                    <tr t-foreach="subscription.line_ids" t-as="line"><td t-out="line.name or line.product_id.display_name"/><td t-out="line.quantity"/><td t-out="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': subscription.currency_id}"/><td t-out="line.price_total" t-options="{'widget': 'monetary', 'display_currency': subscription.currency_id}"/></tr>
                </tbody></table>
                <h4 class="mt-4">Invoices</h4>
                <table class="table"><thead><tr><th>Invoice</th><th>Date</th><th>Due</th><th>Total</th><th>Due amount</th><th>Status</th></tr></thead><tbody>
                    <tr t-foreach="subscription.invoice_ids.filtered(lambda inv: inv.state == 'posted')" t-as="invoice"><td><t t-out="invoice.name"/></td><td t-out="invoice.invoice_date"/><td t-out="invoice.invoice_date_due"/><td t-out="invoice.amount_total" t-options="{'widget': 'monetary', 'display_currency': invoice.currency_id}"/><td t-out="invoice.amount_residual" t-options="{'widget': 'monetary', 'display_currency': invoice.currency_id}"/><td t-out="invoice.payment_state"/></tr>
                </tbody></table>
            </div>
        </t>
    </template>
</odoo>

